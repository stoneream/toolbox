{
  "name": "notion-redmine-migrator",
  "version": "1.0.0",
  "description": "CLI tools for migrating Notion data to Redmine",
  "main": "dist/index.js",
  "bin": {
    "notion-redmine-migrator": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@notionhq/client": "^5.25.2",
    "yargs": "^18.1.0"
  }
}
